generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model StudyPack {
  id          String  @id @default(uuid())
  name        String
  description String?
  goal        String?

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id String @id @default(uuid())

  studyPackId String
  studyPack   StudyPack @relation(fields: [studyPackId], references: [id], onDelete: Cascade)

  originalName String
  mimeType     String
  sizeBytes    Int

  storageKey String?

  status DocumentStatus @default(UPLOADED)

  errorMessage String?

  parser         String?
  parsedMetadata Json?

  units DocumentUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studyPackId])
  @@index([status])
}

model DocumentUnit {
  id String @id @default(uuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  unitIndex Int
  kind      String
  label     String

  text String @db.Text

  metadata Json?

  chunks DocumentChunk[]

  createdAt DateTime @default(now())

  @@unique([documentId, unitIndex])
  @@index([documentId])
  @@index([kind])
}

model DocumentChunk {
  id String @id @default(uuid())

  unitId String
  unit   DocumentUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  chunkIndex Int

  text String @db.Text

  charCount Int
  wordCount Int

  metadata Json?

  embedding Unsupported("vector(384)")?

  embeddingProvider String?
  embeddingModel    String?
  embeddedAt        DateTime?

  createdAt DateTime @default(now())

  @@unique([unitId, chunkIndex])
  @@index([unitId])
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}
