generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model StudyPack {
  id          String  @id @default(uuid())
  name        String
  description String?
  goal        String?

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id String @id @default(uuid())

  studyPackId String
  studyPack   StudyPack @relation(fields: [studyPackId], references: [id], onDelete: Cascade)

  originalName String
  mimeType     String
  sizeBytes    Int

  storageKey String?

  status DocumentStatus @default(UPLOADED)

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studyPackId])
  @@index([status])
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}
