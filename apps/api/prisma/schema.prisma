generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model StudyPack {
  id          String  @id @default(uuid())
  name        String
  description String?
  goal        String?

  documents Document[]
  concepts  Concept[]
  sessions  StudySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id String @id @default(uuid())

  studyPackId String
  studyPack   StudyPack @relation(fields: [studyPackId], references: [id], onDelete: Cascade)

  originalName String
  mimeType     String
  sizeBytes    Int

  storageKey String?

  status DocumentStatus @default(UPLOADED)

  errorMessage String?

  parser         String?
  parsedMetadata Json?

  units DocumentUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studyPackId])
  @@index([status])
}

model DocumentUnit {
  id String @id @default(uuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  unitIndex Int
  kind      String
  label     String

  text String @db.Text

  metadata Json?

  chunks DocumentChunk[]

  createdAt DateTime @default(now())

  @@unique([documentId, unitIndex])
  @@index([documentId])
  @@index([kind])
}

model DocumentChunk {
  id String @id @default(uuid())

  unitId String
  unit   DocumentUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  chunkIndex Int

  text String @db.Text

  charCount Int
  wordCount Int

  metadata Json?

  embedding Unsupported("vector(384)")?

  embeddingProvider String?
  embeddingModel    String?
  embeddedAt        DateTime?

  conceptSources  ConceptSource[]
  questionSources QuestionSource[]

  createdAt DateTime @default(now())

  @@unique([unitId, chunkIndex])
  @@index([unitId])
}

model Concept {
  id String @id @default(uuid())

  studyPackId String
  studyPack   StudyPack @relation(fields: [studyPackId], references: [id], onDelete: Cascade)

  name           String
  normalizedName String

  description String @db.Text

  importance Int @default(3)

  difficulty ConceptDifficulty @default(INTERMEDIATE)

  sources   ConceptSource[]
  questions Question[]

  mastery       ConceptMastery?
  masteryEvents MasteryEvent[]

  currentInSessions StudySession[]           @relation("StudySessionCurrentConcept")
  sessionProgress   SessionConceptProgress[]

  outgoingRelationships ConceptRelationship[] @relation("ConceptRelationshipSource")
  incomingRelationships ConceptRelationship[] @relation("ConceptRelationshipTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyPackId, normalizedName])
  @@index([studyPackId])
}

model ConceptSource {
  id String @id @default(uuid())

  conceptId String
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  chunkId String
  chunk   DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  relevance Float @default(1.0)

  createdAt DateTime @default(now())

  @@unique([conceptId, chunkId])
  @@index([conceptId])
  @@index([chunkId])
}

model ConceptRelationship {
  id String @id @default(uuid())

  sourceConceptId String
  sourceConcept   Concept @relation("ConceptRelationshipSource", fields: [sourceConceptId], references: [id], onDelete: Cascade)

  targetConceptId String
  targetConcept   Concept @relation("ConceptRelationshipTarget", fields: [targetConceptId], references: [id], onDelete: Cascade)

  type ConceptRelationshipType

  strength Float @default(1.0)

  reason String? @db.Text

  createdAt DateTime @default(now())

  @@unique([sourceConceptId, targetConceptId, type])
  @@index([sourceConceptId])
  @@index([targetConceptId])
}

model Question {
  id String @id @default(uuid())

  conceptId String
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  type QuestionType

  difficulty QuestionDifficulty @default(MEDIUM)

  prompt String @db.Text

  expectedAnswer String @db.Text

  sources  QuestionSource[]
  attempts QuestionAttempt[]

  currentInSessions StudySession[] @relation("StudySessionCurrentQuestion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conceptId, type])
  @@index([conceptId])
  @@index([type])
  @@index([difficulty])
}

model QuestionSource {
  id String @id @default(uuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  chunkId String
  chunk   DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  relevance Float @default(1.0)

  createdAt DateTime @default(now())

  @@unique([questionId, chunkId])
  @@index([questionId])
  @@index([chunkId])
}

model SessionMasteryEvent {
  id String @id @default(uuid())

  sessionId String
  conceptId String

  progress SessionConceptProgress @relation(fields: [sessionId, conceptId], references: [sessionId, conceptId], onDelete: Cascade)

  // A single AnswerEvaluation may update this session-local
  // mastery state at most once.
  evaluationId String @unique

  score  Float
  weight Float

  alphaBefore Float
  betaBefore  Float

  alphaAfter Float
  betaAfter  Float

  masteryBefore Float
  masteryAfter  Float

  evidenceWeightBefore Float
  evidenceWeightAfter  Float

  attemptCountBefore Int
  attemptCountAfter  Int

  createdAt DateTime @default(now())

  @@index([sessionId, conceptId])
  @@index([createdAt])
}

model QuestionAttempt {
  id String @id @default(uuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  // A QuestionAttempt may optionally belong to a StudySession.
  //
  // Existing historical attempts remain valid with studySessionId = null.
  // New session-aware answer flows will populate this field.
  studySessionId String?
  studySession   StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)

  // Snapshot the exact question the learner answered.
  //
  // The live Question row may later be updated during question
  // regeneration, but historical attempts must remain interpretable.
  promptSnapshot         String             @db.Text
  expectedAnswerSnapshot String             @db.Text
  questionTypeSnapshot   QuestionType
  difficultySnapshot     QuestionDifficulty

  // Snapshot the evidence that was active when this question was
  // attempted. Live QuestionSource rows may later change.
  evidenceChunkIds String[] @default([])

  answerText String @db.Text

  evaluation AnswerEvaluation?

  createdAt DateTime @default(now())

  @@index([questionId])
  @@index([studySessionId])
  @@index([createdAt])
}

model AnswerEvaluation {
  id String @id @default(uuid())

  attemptId String          @unique
  attempt   QuestionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Normalized score:
  //
  // 0.0 = completely incorrect
  // 1.0 = fully correct
  //
  // Application validation enforces this range.
  score Float

  correctness AnswerCorrectness

  feedback String @db.Text

  missingPoints  String[] @default([])
  misconceptions String[] @default([])

  // Keep evaluator provenance so results remain auditable if the
  // evaluator model or evaluation logic changes later.
  evaluatorProvider String
  evaluatorModel    String
  evaluatorVersion  String @default("v1")

  masteryEvent MasteryEvent?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([correctness])
  @@index([createdAt])
}

model ConceptMastery {
  id String @id @default(uuid())

  conceptId String  @unique
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  // Beta-distribution parameters.
  //
  // Beta(1, 1) represents a neutral prior before StudyLoop has
  // observed any evaluated learner attempts for this concept.
  alpha Float @default(1.0)
  beta  Float @default(1.0)

  // Cached posterior mean:
  //
  // masteryScore = alpha / (alpha + beta)
  //
  // The mastery service is responsible for keeping this value
  // consistent with alpha and beta.
  masteryScore Float @default(0.5)

  // Total weighted evidence accumulated from evaluated attempts.
  evidenceWeight Float @default(0.0)

  attemptCount Int @default(0)

  // Persistent delayed-review state.
  //
  // A null reviewDueAt means no review is currently scheduled.
  // Scheduling policy is owned by application code rather than
  // the mastery calculation itself.
  reviewDueAt DateTime?

  // Stable question level to use when the scheduled review runs.
  // When reviewDueAt is non-null, application logic will ensure
  // reviewQuestionType is also non-null.
  reviewQuestionType QuestionType?

  // Current spacing interval for the review schedule.
  //
  // 0 = no established review interval yet.
  reviewIntervalDays Int @default(0)

  // Timestamp of the most recently completed scheduled review.
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([masteryScore])
  @@index([reviewDueAt])
  @@index([updatedAt])
}

model MasteryEvent {
  id String @id @default(uuid())

  conceptId String
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  // Every AnswerEvaluation may affect mastery at most once.
  //
  // The unique evaluationId is the idempotency guarantee for
  // mastery updates.
  evaluationId String           @unique
  evaluation   AnswerEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  // Evaluation signal used for this update.
  score  Float
  weight Float

  // Complete before/after state makes every mastery transition
  // independently auditable.
  alphaBefore Float
  betaBefore  Float

  alphaAfter Float
  betaAfter  Float

  masteryBefore Float
  masteryAfter  Float

  createdAt DateTime @default(now())

  @@index([conceptId])
  @@index([createdAt])
}

model StudySession {
  id String @id @default(uuid())

  studyPackId String
  studyPack   StudyPack @relation(fields: [studyPackId], references: [id], onDelete: Cascade)

  status StudySessionStatus @default(ACTIVE)

  // NORMAL sessions run the adaptive learning
  // ladder across a bounded concept batch.
  //
  // REVIEW sessions contain a scheduled review
  // concept and use review-specific completion
  // logic rather than the normal learning ladder.
  kind StudySessionKind @default(NORMAL)

  // The concept and question currently presented to the learner.
  //
  // Both become null when the session is complete.
  currentConceptId String?
  currentConcept   Concept? @relation("StudySessionCurrentConcept", fields: [currentConceptId], references: [id], onDelete: SetNull)

  currentQuestionId String?
  currentQuestion   Question? @relation("StudySessionCurrentQuestion", fields: [currentQuestionId], references: [id], onDelete: SetNull)

  // Snapshot concept ordering when the session starts.
  conceptProgress SessionConceptProgress[]

  attempts QuestionAttempt[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([studyPackId])
  @@index([status])
  @@index([kind])
  @@index([currentConceptId])
  @@index([currentQuestionId])
  @@index([startedAt])
}

model SessionConceptProgress {
  id String @id @default(uuid())

  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  conceptId String
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  // Stable concept order captured when the session starts.
  position Int

  status SessionConceptStatus @default(PENDING)

  // ADVANCE_WITH_REVIEW can allow normal progression while preserving
  // the fact that this concept should be revisited later.
  reviewRequired Boolean @default(false)

  // Session-local mastery.
  //
  // This state belongs ONLY to this StudySession + Concept pair.
  // It never inherits the previous session's visible mastery.
  //
  // Internally we use the same neutral Beta(1, 1) prior as lifetime
  // mastery, but sessionMasteryScore intentionally begins at 0 because
  // the fresh session has not yet observed any learner evidence.
  sessionAlpha Float @default(1.0)
  sessionBeta  Float @default(1.0)

  sessionMasteryScore Float @default(0.0)

  sessionEvidenceWeight Float @default(0.0)

  sessionAttemptCount Int @default(0)

  masteryEvents SessionMasteryEvent[]

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, conceptId])
  @@unique([sessionId, position])
  @@index([sessionId])
  @@index([conceptId])
  @@index([status])
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum ConceptDifficulty {
  FOUNDATIONAL
  INTERMEDIATE
  ADVANCED
}

enum ConceptRelationshipType {
  PREREQUISITE
  BUILDS_ON
  RELATED_TO
}

enum QuestionType {
  RECALL
  UNDERSTANDING
  APPLICATION
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AnswerCorrectness {
  CORRECT
  PARTIAL
  INCORRECT
}

enum StudySessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum StudySessionKind {
  NORMAL
  REVIEW
}

enum SessionConceptStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REVIEW_REQUIRED
}
